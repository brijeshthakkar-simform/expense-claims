{
  "name": "expense-claims",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:pretty": "next dev | pino-pretty",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:diff-check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test",
    "verify": "pnpm db:generate && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:unit && pnpm test:component && pnpm test:int",
    "verify:integrity": "tsx --conditions=react-server scripts/verify-integrity.ts",
    "policy:activate-tier": "tsx --conditions=react-server scripts/policy-activate-tier.ts",
    "perf:seed": "tsx --conditions=react-server scripts/perf/seed-perf.ts",
    "perf:explain": "tsx --conditions=react-server scripts/perf/explain.ts",
    "compose:up": "docker compose up --build --wait",
    "compose:down": "docker compose down",
    "compose:reset": "docker compose down -v"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@hookform/resolvers": "5.9.1",
    "@next/env": "16.4.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testcontainers/postgresql": "12.2.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.1",
    "pg-copy-streams": "7.0.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.3"
  }
}
